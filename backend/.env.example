# Copy to .env for local development (never commit the real .env).

# Matches docker-compose.yml's db service.
DATABASE_URL=postgresql://chokepoint:chokepoint@localhost:5432/chokepoint

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme-generate-a-real-one

# Optional locally — without it, app/email.py logs instead of sending.
RESEND_API_KEY=
EMAIL_FROM=alerts@chokepoint-access.example
