# ---- client and commercial material: never commit ----
client_spend*.csv
brief*.html
standdown*.html
attestation*.html

# ---- third-party copyright: the facts are ours, the documents are not ----
*.docx
*.pdf

# ---- the paper's own outputs stay local while it is under review ----
/final_output/
/output/
*_Manuscript*.docx

# ---- the vintage is fetched by the workflow, never redistributed from here ----
/data/

# ---- generated in src/ and regenerated into docs/ by the workflow.
#      These paths are ANCHORED with a leading slash on purpose: unanchored,
#      they would also match docs/readings.json, which the published pages
#      fetch — git add would skip it silently and the live site would show
#      no readings with no error anywhere. ----
/src/readings.json
/src/track-record.html
/src/index.html
/src/outputs/
*.part

# ---- keep: these ARE the asset ----
!/src/record.jsonl
!/src/outcomes.csv
!/src/warrisk.csv
!/src/warrisk_jwc.csv
!/src/jwc_snapshots.csv
!/src/tar_reference.json

# ---- everything under docs/ is the published site; nothing here is ignored ----
!/docs/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- corridor-validation research (validation/): large/regenerable inputs
#      and derived panels are not tracked. Scripts, corridors.csv,
#      doc_queries.csv, and report/ (the actual written analysis --
#      phase_d_corridor_grades.md and the recall-test writeups) ARE tracked;
#      those are the deliverable, not something to regenerate silently. ----
/validation/data/*
/validation/build/

# ---- keep: these are paid BigQuery query results, not regenerable for
#      free, and chokepoint_profiles.py cites them directly as its
#      evidence source. (Must except children of data/, not the directory
#      itself -- git will not look inside a wholesale-excluded directory
#      for negation patterns to apply.) ----
!/validation/data/webngrams_5corridor_smoketest.csv
!/validation/data/webngrams_blacksea_event2.csv
!/validation/data/webngrams_suez2_taiwan2.csv

# ---- backend (Phase 5): secrets never committed ----
.env
backend/.env

# ---- unidentified secret-shaped file at repo root, flagged 2026-08-16 --
#      user doesn't recognize it either; gitignored rather than deleted
#      since deleting an untracked file is unrecoverable ----
/backend secret.txt

# ---- backend (Phase 5): local SQLite dev/test databases -- runtime state,
#      not source; regenerated by alembic upgrade head / pytest ----
backend/*.db
